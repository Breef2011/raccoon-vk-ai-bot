# ============================================================================
# Шаблон переменных окружения.
# Скопируйте файл в .env и заполните значения вручную.
# Файл .env добавлен в .gitignore и не должен попадать в Git.
# Реальные токены и ключи в этот файл записывать нельзя.
# ============================================================================

# --- Обязательные переменные ---

# Токен доступа сообщества ВКонтакте (ключ доступа с правом «Сообщения сообщества»).
VK_GROUP_TOKEN=

# Authorization Key из GigaChat Studio (строка Base64 вида Client ID:Client Secret).
GIGACHAT_CREDENTIALS=

# --- GigaChat: необязательные настройки ---

# Область доступа: GIGACHAT_API_PERS для физлиц, GIGACHAT_API_B2B / GIGACHAT_API_CORP для юрлиц.
GIGACHAT_SCOPE=

# Идентификатор модели, например GigaChat-2, GigaChat-2-Lite, GigaChat-2-Pro, GigaChat-2-Max.
GIGACHAT_MODEL=

# Базовый адрес API GigaChat.
GIGACHAT_BASE_URL=

# Адрес получения OAuth-токена.
GIGACHAT_OAUTH_URL=

# Проверять ли TLS-сертификат (true/false).
GIGACHAT_VERIFY_SSL=

# Путь к PEM-файлу с корневым сертификатом, если требуется своя цепочка доверия.
GIGACHAT_CA_BUNDLE=

# Температура генерации (0–2). Чем ниже, тем стабильнее ответы.
GIGACHAT_TEMPERATURE=

# Максимальное количество токенов в ответе модели.
GIGACHAT_MAX_TOKENS=

# --- ВКонтакте: необязательные настройки ---

# Числовой ID сообщества. Если не указан, бот определит его по токену.
VK_GROUP_ID=

# Способ получения сообщений: auto, longpoll или polling.
# auto — Long Poll, а если события в сообществе не включены, опрос диалогов.
VK_TRANSPORT=

# --- Контакты и поведение бота ---

# Ссылка на форму для связи с менеджером. Если не указана, бот предложит написать в сообщения сообщества.
CONTACT_FORM_URL=

# Сколько последних сообщений диалога (вопросов и ответов) хранить в памяти.
MAX_HISTORY_MESSAGES=

# Через сколько минут очищать неактивный диалог.
DIALOG_TTL_MINUTES=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=
